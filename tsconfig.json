{
  // Host build: compiles the TypeScript sources in `src/` to the package-root
  // ESM artifacts consumed by the manifest. The browser half has its own build
  // because a classic-script emit cannot share this program's module mode.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": false,
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "files": ["src/shims.d.ts", "src/projection.ts", "src/index.ts"]
}
